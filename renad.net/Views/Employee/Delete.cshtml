@model Employee
@{
    ViewData["Title"] = "Delete Employee";
}

<h2>Delete Employee</h2>
<p class="mt-3">Are you sure you want to delete <strong>@Model.Employee_Name</strong> (@Model.Department?.Department_Name)?</p>

<form asp-action="Delete" asp-route-id="@Model.Employee_Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
